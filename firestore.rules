rules_version = '2';

// Anyone can register teams and enter matches, goals and assists (shape and size are validated).
// Deleting, resetting and changing tournament settings require the admin Google account.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'hasangunduz1010@gmail.com';
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    function validTeam(d) {
      return d.keys().hasOnly(['name', 'captain', 'players', 'createdAt'])
        && shortString(d.name, 40) && d.name.size() > 0
        && (!('captain' in d) || shortString(d.captain, 40))
        && d.players is list && d.players.size() <= 25
        && d.createdAt is timestamp;
    }

    function validMatch(d) {
      return d.keys().hasOnly(['homeTeamId', 'awayTeamId', 'date', 'pitch', 'status', 'goals', 'createdAt'])
        && shortString(d.homeTeamId, 40) && shortString(d.awayTeamId, 40)
        && d.homeTeamId != d.awayTeamId
        && shortString(d.date, 20)
        && shortString(d.pitch, 40)
        && d.status in ['scheduled', 'played']
        && d.goals is list && d.goals.size() <= 60
        && d.createdAt is timestamp;
    }

    match /teams/{id} {
      allow read: if true;
      allow create, update: if validTeam(request.resource.data);
      allow delete: if isAdmin();
    }

    match /matches/{id} {
      allow read: if true;
      allow create, update: if validMatch(request.resource.data);
      allow delete: if isAdmin();
    }

    match /meta/settings {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['tournamentName'])
        && shortString(request.resource.data.tournamentName, 60);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
